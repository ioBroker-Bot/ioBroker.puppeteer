{
    "type": "panel",
    "i18n": true,
    "items": {
        "useExternalBrowser": {
            "type": "checkbox",
            "label": "useExternalBrowser",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "executablePath": {
            "placeholder": "executablePathPlaceholder",
            "hidden": "!data.useExternalBrowser",
            "newLine": true,
            "type": "text",
            "label": "executablePath",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "additionalArgs": {
            "newLine": true,
            "label": "additionalLaunchArgs",
            "type": "table",
            "uniqueColumns": [
                "Argument"
            ],
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12,
            "items": [
                {
                    "attr": "Argument",
                    "label": "argument",
                    "filter": false,
                    "sort": false,
                    "type": "autocomplete",
                    "freeSolo": true,
                    "options": [
                        "--disable-lcd-text",
                        "--disable-composited-antialiasing"
                    ]
                }
            ]
        },
        "maxParallelRenders": {
            "newLine": true,
            "type": "number",
            "min": 0,
            "step": 1,
            "label": "maxParallelRenders",
            "help": "maxParallelRendersHelp",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "webInstance": {
            "newLine": true,
            "type": "instance",
            "adapter": "web",
            "all": true,
            "label": "webInstance",
            "help": "webInstanceHelp",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "webPath": {
            "type": "text",
            "label": "webPath",
            "help": "webPathHelp",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        }
    }
}
